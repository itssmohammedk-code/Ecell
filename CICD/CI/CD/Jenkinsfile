pipeline {
    agent any

    environment {
        PATH = "/usr/local/bin:/usr/bin:/bin:${env.PATH}"

        DEPLOY_REPO_URL = 'https://github.com/itssmohammedk-code/Ecell-deploy.git'
        DEPLOY_BRANCH = 'main'

        KUBECONFIG_CRED_ID = 'k8s-kubeconfig'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Checkout Deploy Repository') {
            steps {
                echo "Cloning deployment repository: ${DEPLOY_REPO_URL}"

                git branch: "${DEPLOY_BRANCH}",
                    url: "${DEPLOY_REPO_URL}"
            }
        }

        stage('Verify Required Files') {
            steps {
                sh '''
                    set -e

                    echo "Checking application manifests..."

                    test -f 00-namespace.yaml

                    echo "Checking monitoring manifests..."

                    test -f k8s/monitoring/00-monitoring-namespace.yaml
                    test -f k8s/monitoring/01-prometheus-rbac.yaml
                    test -f k8s/monitoring/02-prometheus-config.yaml
                    test -f k8s/monitoring/03-prometheus-deployment.yaml
                    test -f k8s/monitoring/04-prometheus-service.yaml
                    test -f k8s/monitoring/05-grafana-datasource.yaml
                    test -f k8s/monitoring/06-grafana-deployment.yaml
                    test -f k8s/monitoring/07-grafana-service.yaml

                    echo "All required files are present."
                '''
            }
        }

        stage('Verify Cluster Connectivity') {
            steps {
                withCredentials([
                    file(
                        credentialsId: "${KUBECONFIG_CRED_ID}",
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Testing Kubernetes connection..."

                        kubectl cluster-info
                        kubectl get nodes -o wide
                    '''
                }
            }
        }

        stage('Deploy Application') {
            steps {
                withCredentials([
                    file(
                        credentialsId: "${KUBECONFIG_CRED_ID}",
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Deploying Ecell application..."

                        if [ -f "kustomization.yaml" ]; then
                            kubectl apply -k ./
                        else
                            kubectl apply -f 00-namespace.yaml

                            if [ -f "01-secret.yaml" ]; then
                                kubectl apply -f 01-secret.yaml
                            fi

                            if [ -f "02-db.yaml" ]; then
                                kubectl apply -f 02-db.yaml
                            fi

                            if [ -f "03-backend.yaml" ]; then
                                kubectl apply -f 03-backend.yaml
                            fi

                            if [ -f "04-frontend.yaml" ]; then
                                kubectl apply -f 04-frontend.yaml
                            fi
                        fi
                    '''
                }
            }
        }

        stage('Verify Application Rollout') {
            steps {
                withCredentials([
                    file(
                        credentialsId: "${KUBECONFIG_CRED_ID}",
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Checking PostgreSQL rollout..."
                        kubectl rollout status deployment/ecell-db \
                            -n ecell \
                            --timeout=180s

                        echo "Checking backend rollout..."
                        kubectl rollout status deployment/ecell-backend \
                            -n ecell \
                            --timeout=180s

                        echo "Checking frontend rollout..."
                        kubectl rollout status deployment/ecell-frontend \
                            -n ecell \
                            --timeout=180s
                    '''
                }
            }
        }

        stage('Deploy Monitoring Namespace and RBAC') {
            steps {
                withCredentials([
                    file(
                        credentialsId: "${KUBECONFIG_CRED_ID}",
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Creating monitoring namespace..."

                        kubectl apply \
                            -f k8s/monitoring/00-monitoring-namespace.yaml

                        echo "Creating Prometheus permissions..."

                        kubectl apply \
                            -f k8s/monitoring/01-prometheus-rbac.yaml
                    '''
                }
            }
        }

        stage('Deploy Prometheus') {
            steps {
                withCredentials([
                    file(
                        credentialsId: "${KUBECONFIG_CRED_ID}",
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Deploying Prometheus..."

                        kubectl apply \
                            -f k8s/monitoring/02-prometheus-config.yaml

                        kubectl apply \
                            -f k8s/monitoring/03-prometheus-deployment.yaml

                        kubectl apply \
                            -f k8s/monitoring/04-prometheus-service.yaml
                    '''
                }
            }
        }

        stage('Verify Prometheus') {
            steps {
                withCredentials([
                    file(
                        credentialsId: "${KUBECONFIG_CRED_ID}",
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Waiting for Prometheus rollout..."

                        kubectl rollout status deployment/prometheus \
                            -n monitoring \
                            --timeout=180s

                        kubectl get pods \
                            -n monitoring \
                            -l app=prometheus \
                            -o wide

                        kubectl get service prometheus \
                            -n monitoring
                    '''
                }
            }
        }

        stage('Deploy Grafana') {
            steps {
                withCredentials([
                    file(
                        credentialsId: "${KUBECONFIG_CRED_ID}",
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Deploying Grafana..."

                        kubectl apply \
                            -f k8s/monitoring/05-grafana-datasource.yaml

                        kubectl apply \
                            -f k8s/monitoring/06-grafana-deployment.yaml

                        kubectl apply \
                            -f k8s/monitoring/07-grafana-service.yaml
                    '''
                }
            }
        }

        stage('Verify Grafana') {
            steps {
                withCredentials([
                    file(
                        credentialsId: "${KUBECONFIG_CRED_ID}",
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Waiting for Grafana rollout..."

                        kubectl rollout status deployment/grafana \
                            -n monitoring \
                            --timeout=180s

                        kubectl get pods \
                            -n monitoring \
                            -l app=grafana \
                            -o wide

                        kubectl get service grafana \
                            -n monitoring
                    '''
                }
            }
        }

        stage('Deployment Status Summary') {
            steps {
                withCredentials([
                    file(
                        credentialsId: "${KUBECONFIG_CRED_ID}",
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        echo "Application resources:"
                        kubectl get all,pvc -n ecell

                        echo ""
                        echo "Monitoring resources:"
                        kubectl get all -n monitoring

                        echo ""
                        echo "Monitoring access ports:"
                        echo "Prometheus: http://EC2-PUBLIC-IP:30090"
                        echo "Grafana:    http://EC2-PUBLIC-IP:30300"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Application, Prometheus and Grafana deployed successfully."
            echo "Prometheus NodePort: 30090"
            echo "Grafana NodePort: 30300"
        }

        failure {
            echo "Continuous Deployment failed. Check the Jenkins logs."

            withCredentials([
                file(
                    credentialsId: "${KUBECONFIG_CRED_ID}",
                    variable: 'KUBECONFIG'
                )
            ]) {
                sh '''
                    echo "Monitoring pod status:"
                    kubectl get pods -n monitoring -o wide || true

                    echo "Recent monitoring events:"
                    kubectl get events \
                        -n monitoring \
                        --sort-by=.metadata.creationTimestamp \
                        | tail -30 || true
                '''
            }
        }

        always {
            cleanWs()
        }
    }
}
